page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2f54eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-plain {
  background: #fff;
  color: #2f54eb;
  border: 1rpx solid #2f54eb;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.muted {
  color: #999;
  font-size: 24rpx;
}
