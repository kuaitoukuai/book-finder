.login-wrap {
  padding: 80rpx 0;
}

.logo {
  text-align: center;
  font-size: 56rpx;
  font-weight: 600;
  color: #2f54eb;
}

.subtitle {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin: 16rpx 0 48rpx;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  color: #999;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.submit {
  margin-top: 12rpx;
}

.switch {
  text-align: center;
  color: #2f54eb;
  font-size: 26rpx;
  padding: 28rpx 0 8rpx;
}
