/* 与小程序现有页面同一套色板（主色 #2f54eb，底色 #f5f6fa） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 140rpx 60rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f5f6fa;
}

.brand {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 3rpx;
  margin-bottom: 90rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-top: 44rpx;
}

.hint {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #666;
  text-align: center;
}

/* 对勾与感叹号用字符而非图片，省掉一次资源加载 */
.icon {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 500;
}

.icon-ok {
  background: #e8f5e9;
  color: #07c160;
}

.icon-warn {
  background: #fdf3e7;
  color: #b45309;
}

.spinner {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid #e5e5e5;
  border-top-color: #2f54eb;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.btn {
  margin-top: 64rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #2f54eb;
  color: #ffffff;
}

.btn::after {
  border: none;
}

.cancel {
  margin-top: 56rpx;
  font-size: 26rpx;
  color: #999;
  text-decoration: underline;
}

.foot {
  margin-top: auto;
  padding-top: 80rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
  text-align: center;
}
